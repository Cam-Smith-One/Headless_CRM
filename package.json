{
  "name": "headless-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo build",
    "db:generate": "npm run generate -w packages/db",
    "db:migrate": "npm run migrate -w packages/db",
    "db:seed": "npm run seed -w packages/db",
    "setup": "./scripts/setup.sh",
    "setup:sqlite": "./scripts/setup-sqlite.sh",
    "selfhost:check": "node scripts/doctor-selfhost.mjs",
    "selfhost:sqlite": "node scripts/selfhost-sqlite.mjs",
    "sqlite:backup": "./scripts/backup-sqlite.sh",
    "sqlite:restore": "./scripts/restore-sqlite.sh",
    "start": "npx tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1",
    "@tailwindcss/oxide-linux-x64-musl": "4.2.1"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "next": {
      "postcss": "^8.5.14"
    }
  },
  "license": "AGPL-3.0",
  "description": "The open-source CRM built for AI agents. MCP-native, API-first, self-hostable."
}
