{
  "name": "@headless-crm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./sqlite-schema": "./src/sqlite-schema.ts",
    "./sqlite-client": "./src/sqlite-client.ts",
    "./adapter": "./src/adapter.ts"
  },
  "scripts": {
    "build": "tsc",
    "generate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "generate:sqlite": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs generate --config=drizzle-sqlite.config.ts",
    "migrate:sqlite": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=drizzle-sqlite.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^5.0.0",
    "postgres": "^3.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
