{
  "name": "@headless-crm/db",
  "version": "0.1.1",
  "description": "Drizzle ORM schemas, migrations, and seed data for Headless CRM (PostgreSQL + SQLite)",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./sqlite-schema": "./src/sqlite-schema.ts",
    "./sqlite-client": "./src/sqlite-client.ts",
    "./adapter": "./src/adapter.ts"
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "generate:sqlite": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs generate --config=drizzle-sqlite.config.ts",
    "migrate:sqlite": "node --env-file-if-exists=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=drizzle-sqlite.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "@neondatabase/serverless": "^1.1.0",
    "postgres": "^3.4.9",
    "nanoid": "^5.1.15"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
