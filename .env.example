# Database
DATABASE_URL=postgresql://headless:headless@localhost:5433/headless_crm

# Redis (optional — omit for Postgres-only mode)
# REDIS_URL=redis://localhost:6379

# Agent Auth (JWT for AI agents — used by packages/auth)
JWT_SECRET=change-me-in-production

# Human Auth (Better Auth — dashboard login for team members)
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production-32chars!!
# Canonical URL of your deployment (required on Vercel; used for OAuth redirect URIs)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth providers (optional — omit to use email/password only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Show OAuth buttons in the login UI when providers are configured
# NEXT_PUBLIC_OAUTH_ENABLED=true

# API
PORT=3001

# Admin API Key for bootstrap agent provisioning
ADMIN_API_KEY=change-me-in-production

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=crm@headless-crm.dev

# OpenAI
OPENAI_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Headless CRM Token
HEADLESS_CRM_TOKEN=
